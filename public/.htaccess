# SPA fallback for the client-side router (react-router BrowserRouter).
# chromaforge.app is served by Apache on Hostinger; without this, deep links and
# hard refreshes of client routes (e.g. /shop, /gallery, /account) would 404 because
# the server looks for literal files/dirs by those names. This rewrites any request
# that isn't a real file or directory to index.html, letting React Router resolve it.
#
# Vite copies everything in public/ into dist/, and the rsync deploy syncs dist/ to the
# web root, so this lands at the site root automatically. Real assets (JS/CSS/images,
# and the existing /createjs.min.js, /jscolor.js globals) are served directly because
# of the RewriteCond file/dir checks below.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^index\.html$ - [L]

  # A MISSING file under /assets/ is a stale-bundle reference, never a client route --
  # deploys rsync with --delete-after, so an old chunk really is gone from the server.
  # Without this it fell through to the SPA fallback and returned index.html as
  # "200 text/html" where the browser expected JS, surfacing as a blank page or an opaque
  # "failed to fetch dynamically imported module". A real 404 makes that failure legible.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^assets/ - [R=404,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Serve our own body for that 404 instead of the server's default. This is not cosmetic:
# LiteSpeed's built-in 404 page ships a Last-Modified ~15 months old and NO Cache-Control
# (measured live 2026-07-28), and 404 is a heuristically-cacheable status (RFC 9110 15.1),
# so a browser could cache it for weeks -- on a content-hashed URL, i.e. one that will
# never change name, permanently breaking that chunk for that visitor if they happened to
# request it during a deploy. Routing through a .html file puts it under the no-cache rule
# below, which is the whole fix.
ErrorDocument 404 /404.html

# Cache policy. Hostinger's own default gave static files "public, max-age=604800" and
# gave index.html NOTHING at all -- and no Cache-Control means browsers fall back to
# HEURISTIC freshness (RFC 9111 4.2.2), commonly 10% of the time since Last-Modified.
# So the longer a deploy sat live, the longer a returning phone would serve the cached
# HTML without even revalidating. index.html is what names the hashed bundles, so stale
# HTML pins the whole app to an old version. Setting these explicitly also stops the
# policy depending on an undocumented host default that can change under us.
#
# <FilesMatch> matches on BASENAME only, so the rule below cannot exclude /assets/ by
# path. It doesn't need to: public/assets/.htaccess overrides it for that directory,
# since Apache merges a parent .htaccess before a child's. The earlier attempt at
# excluding it here -- a mod_rewrite E=HASHED_ASSET var read back via "Header ... env=" --
# is NOT honored by LiteSpeed and silently left hashed bundles on the one-hour rule.
<IfModule mod_headers.c>
  # index.html (and every client route, since the fallback above serves this file for
  # them, plus 404.html via ErrorDocument) must revalidate every time. Cheap: the ETag
  # turns the check into a ~4KB 304. "always" because this has to reach the 404 too, and
  # unlike a positive lifetime, no-cache on an error response is exactly what we want.
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-cache, must-revalidate"
    Header always unset Expires
  </FilesMatch>

  # Everything in public/ keeps a FIXED filename across deploys (createjs.min.js,
  # jscolor.js, manifest.json, og-image.jpg, models/tshirt/*), so content hashing can't
  # help and the host default meant a change took up to 7 days to reach a repeat visitor.
  # An hour of freshness, then a 304-cheap revalidate, bounds that at ~1h.
  # "set" rather than "always": no error response should carry a positive cache lifetime.
  <FilesMatch "\.(js|css|json|png|jpe?g|gif|svg|ico|webp|woff2?|glb|gltf|bin)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
    Header always unset Expires
  </FilesMatch>
</IfModule>
