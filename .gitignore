# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Unanchored on purpose: `/node_modules` only ever covered the repo root, so
# render-service/node_modules was tracked by accident -- 39 files including macOS-only
# native binaries (a 27MB skia .node) that nothing uses. The Docker image runs its own
# `npm ci` from package-lock.json, and scripts/check-render-regression.mjs symlinks the
# local install into its worktree, so no build path ever wanted them in git.
node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/dist

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# One-off backfill rollback snapshots (scripts/backfill-*.mjs) -- real row data, kept locally
geometry-chance-rollback-*.json
# render-service/backfill-avatars.mjs: each run's record (user ids and names -- what --undo
# reads) and a dry run's preview images
render-service/avatar-backfill-*.json
render-service/avatar-backfill-preview/

# Output of render-service/spike-test.js (regenerated on every run)
render-service/spike-*.png

# The local ad builder's photos, rendered music and saved ads (scripts/ad-builder-dev.mjs)
/.ads/
