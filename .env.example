# ChromaForge environment variables.
# Copy this file to `.env.local` (which is gitignored) and fill in your values.
#
# Both Supabase values below are CLIENT-SAFE: the anon key only grants access
# allowed by Row Level Security policies. Never put the service_role key here.
#
# Find these in your Supabase project dashboard: Settings -> API.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
